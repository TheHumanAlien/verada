# Build-time defaults. Everything here is public and is overridable at runtime
# by editing config.json in the published bundle. No secrets.
NEXT_PUBLIC_CHAIN_ID=1
# Comma-separated indexer base URLs, tried in order (failover).
NEXT_PUBLIC_INDEXER_URLS=http://localhost:42069
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
# Private RPC (anon-rpc). All chain reads go through this anonymizing network so the
# RPC provider never sees the user's IP. One of: nym (default), tor-js, passthrough (testing only).
NEXT_PUBLIC_ANON_RPC_NETWORK=nym
# Comma-separated RPCs reached THROUGH the anon network, in failover order. Empty: NEXT_PUBLIC_RPC_URL
# (if set) followed by public RPCs known to accept mixnet exits. Overridable in config.json under
# "privateRpc": { "network", "rpcUrls", "specifier", "workerConfig", "bootstrapRpcUrl" }.
NEXT_PUBLIC_PRIVATE_RPC_URLS=
